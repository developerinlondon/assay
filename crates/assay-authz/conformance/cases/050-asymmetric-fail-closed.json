      "check": {
        "subjects": [{ "kind": "token", "id": "svc" }],
        "action": "docs.read",
        "resource": "doc:x",
        "scopeChain": [{ "kind": "root", "id": "*" }],
        "context": {}
      },
      "expect": "deny"
    },
