{
  "suite": "asymmetric-fail-closed",
  "scopeKinds": ["root"],
  "conditionKeys": {
    "app:Email": { "type": "string", "lowercase": true },
    "app:Role": { "type": "string" },
    "app:Source": { "type": "string" }
  },
  "cases": [
    {
      "name": "an allow with an unknown operator never allows",
      "grants": [
        {
          "subject": { "kind": "user", "id": "alice" },
          "scope": { "kind": "root", "id": "*" },
          "statements": [
            {
              "effect": "allow",
              "actions": ["docs.read"],
              "resources": ["*"],
              "conditions": [{ "operator": "Bogus", "key": "app:Source", "value": "x" }]
            }
          ]
        }
      ],
      "check": {
        "subjects": [{ "kind": "user", "id": "alice" }],
        "action": "docs.read",
        "resource": "doc:x",
        "scopeChain": [{ "kind": "root", "id": "*" }],
        "context": { "app:Source": "api" }
      },
      "expect": "deny"
    },
    {
      "name": "an allow on an undeclared key never allows",
      "grants": [
        {
          "subject": { "kind": "user", "id": "alice" },
          "scope": { "kind": "root", "id": "*" },
          "statements": [
            {
              "effect": "allow",
              "actions": ["docs.read"],
              "resources": ["*"],
              "conditions": [
                { "operator": "StringEquals", "key": "aws:SourceIp", "value": "1.2.3.4" }
              ]
            }
          ]
        }
      ],
      "check": {
        "subjects": [{ "kind": "user", "id": "alice" }],
        "action": "docs.read",
        "resource": "doc:x",
        "scopeChain": [{ "kind": "root", "id": "*" }],
        "context": {}
      },
      "expect": "deny"
    },
    {
      "name": "a crafted prototype-chain key never resolves",
      "grants": [
        {
          "subject": { "kind": "user", "id": "alice" },
          "scope": { "kind": "root", "id": "*" },
          "statements": [
            {
              "effect": "allow",
              "actions": ["docs.read"],
              "resources": ["*"],
              "conditions": [{ "operator": "StringEquals", "key": "__proto__", "value": "x" }]
            }
          ]
        }
      ],
      "check": {
        "subjects": [{ "kind": "user", "id": "alice" }],
        "action": "docs.read",
        "resource": "doc:x",
        "scopeChain": [{ "kind": "root", "id": "*" }],
        "context": {}
      },
      "expect": "deny"
    },
