{
  "suite": "conditions",
  "scopeKinds": ["root"],
  "conditionKeys": {
    "app:Email": { "type": "string", "lowercase": true },
    "app:Kind": { "type": "string" },
    "app:Role": { "type": "string" },
    "app:Source": { "type": "string" },
    "app:ScopeId": { "type": "string" }
  },
  "cases": [
    {
      "name": "StringEquals: a matching condition lets the allow contribute",
      "grants": [
        {
          "subject": { "kind": "user", "id": "alice" },
          "scope": { "kind": "root", "id": "*" },
          "statements": [
            {
              "effect": "allow",
              "actions": ["docs.read"],
              "resources": ["*"],
              "conditions": [
                { "operator": "StringEquals", "key": "app:Source", "value": "admin-api" }
              ]
            }
          ]
        }
      ],
      "check": {
        "subjects": [{ "kind": "user", "id": "alice" }],
        "action": "docs.read",
        "resource": "doc:x",
        "scopeChain": [{ "kind": "root", "id": "*" }],
        "context": { "app:Source": "admin-api" }
      },
      "expect": "allow"
    },
    {
      "name": "StringEquals: a non-matching condition withholds the allow",
      "grants": [
        {
          "subject": { "kind": "user", "id": "alice" },
          "scope": { "kind": "root", "id": "*" },
          "statements": [
            {
              "effect": "allow",
              "actions": ["docs.read"],
              "resources": ["*"],
              "conditions": [
